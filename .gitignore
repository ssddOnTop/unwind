# Publish source by explicit allowlist. Everything else stays local by default.
# New directories/file types require deliberate review before inclusion.
*
!/.gitignore

# Backend code, tests, dependency lock and local runner.
!/be/
!/be/companion/
!/be/companion/**/
!/be/companion/**/*.py
!/be/tests/
!/be/tests/**/
!/be/tests/**/*.py
!/be/pyproject.toml
!/be/uv.lock
!/be/run-local.sh
!/be/README.md

# Native iOS app, portable core, tests and shared project configuration.
!/fe/
!/fe/App/
!/fe/App/**/
!/fe/App/**/*.swift
!/fe/App/Info.plist
!/fe/App/LocalCompanion.entitlements
!/fe/Core/
!/fe/Core/Package.swift
!/fe/Core/Package.resolved
!/fe/Core/Sources/
!/fe/Core/Sources/**/
!/fe/Core/Sources/**/*.swift
!/fe/Core/Tests/
!/fe/Core/Tests/**/
!/fe/Core/Tests/**/*.swift
!/fe/Core/Tests/CompanionCoreTests/Fixtures/state.example.json
!/fe/Core/Tests/CompanionCoreTests/Fixtures/observation-batch.example.json
!/fe/UITests/
!/fe/UITests/**/
!/fe/UITests/**/*.swift
!/fe/LocalCompanion.xcodeproj/
!/fe/LocalCompanion.xcodeproj/project.pbxproj
!/fe/LocalCompanion.xcodeproj/xcshareddata/
!/fe/LocalCompanion.xcodeproj/xcshareddata/xcschemes/
!/fe/LocalCompanion.xcodeproj/xcshareddata/xcschemes/*.xcscheme
!/fe/scripts/
!/fe/scripts/*.py
!/fe/scripts/*.sh
!/fe/scripts/*.swift
!/fe/README.md

# Reviewed public schemas and explicitly synthetic fixtures.
!/contracts/
!/contracts/state.schema.json
!/contracts/state.example.json
!/contracts/observation-batch.example.json
!/contracts/scenarios.json
!/contracts/v1.md
!/contracts/plaid.md
!/contracts/plaid.schema.json
!/contracts/auth.md
!/contracts/experience.md
!/contracts/experience.schema.json
!/contracts/banking.md
!/contracts/banking.schema.json
!/scripts/
!/scripts/*.py
!/scripts/*.sh
!/scripts/*.swift

# Defense in depth: never publish runtime data, secrets, personal IDE state,
# research downloads, machine-repair backups or generated test/build artifacts.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
*.sqlite*
*.db
*.db-*
*.log
*.py[cod]
*.xcuserstate
.DS_Store
**/xcuserdata/
**/__pycache__/
**/.venv*/
**/.cache/
**/.firecrawl/
**/.pytest*/
**/.build/
**/.data*/
**/DerivedData/
**/evidence/
**/backups/
/research/
/PLAN.md
/.repo-clone/
