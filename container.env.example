# PUBLIC configuration template only. Copy to .env; chmod 600 .env.
# Fill privately. Never commit .env or print `docker compose config` with real secrets.
DATABASE_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=[]
# Optional: omit entirely when unused (an empty audience is invalid).
# CLERK_AUDIENCE=
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_WEBHOOK_URL=
# Absolute host paths; existing directory/certificate only, never auto-created.
COMPANION_DATA_DIR=
SUPABASE_CA_FILE=
COMPANION_DAILY_SYNTHESIS_MODE=disabled
# Optional explicit free-model configuration; no provider is configured by default.
# COMPANION_LLM_PROVIDER=openrouter
# COMPANION_LLM_MODEL=
# OPENROUTER_API_KEY=
